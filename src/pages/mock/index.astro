---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="AQA A-level Environmental Science mini-mock builder: timed papers from real questions" description="Build a timed mini-mock from real AQA Environmental Science past-paper questions in the shape of Paper 1 or Paper 2: whole structured questions, an essay choice, or a full 120-mark paper. Play it on screen or print it with the mark schemes." context="mock" leadLine="Want a mock marked properly and gone through? Message us.">
  <h1>Mini-mock builder</h1>
  <p>Assembles a paper from real AQA questions in the shape of the exam. Each 7447 paper is 3 hours and 120 marks: about 95 marks of structured questions (short answers, data, calculations and nine-mark extended responses) and then question 11, a choice of two 25-mark essays. That is 90 seconds a mark. Structured questions are kept whole, so every part has the figure or table it needs.</p>
  <div class="panel" id="setup">
    <h3>Paper</h3>
    <div class="chips" data-group="paper"><button class="chip" type="button" data-v="Paper 1" aria-pressed="true">Paper 1 (physical environment, energy, pollution)</button><button class="chip" type="button" data-v="Paper 2">Paper 2 (living environment, biological resources, sustainability)</button></div>
    <h3>Length</h3>
    <div class="chips" data-group="part"><button class="chip" type="button" data-v="B" aria-pressed="true">Structured questions, about 40 marks (1 hour)</button><button class="chip" type="button" data-v="E">Essay choice only (25 marks)</button><button class="chip" type="button" data-v="full">Full paper (3 hours)</button></div>
    <p class="muted" id="shape"></p>
    <div><button class="btn btn-accent" type="button" id="build">Build my mock</button></div>
  </div>
  <div id="paper" hidden>
    <div class="playbar"><span id="title"></span><span class="timer" id="timer"></span><span><button class="btn" type="button" id="starttimer"><Icon name="timer" />Start timer</button> <button class="btn" type="button" id="print"><Icon name="printer" />Print</button> <button class="btn" type="button" id="share"><Icon name="link" />Copy link</button></span></div>
    <div id="cards"></div>
    <div class="btn-row"><button class="btn btn-accent" type="button" id="rebuild">Build another</button></div>
  </div>
  <script>
    import { loadBank, card, shuffle, fmtTime } from '../../scripts/player.js';
    const $ = (s) => document.querySelector(s);
    const sel = { paper: 'Paper 1', part: 'B' };
    let bank = null, timer = null, secs = 0;
    const SEC_PER_MARK = 90;
    const TEXT = { B: 'Whole structured questions adding up to about 40 marks (1 hour).', E: 'One real question 11: two essay titles, answer one (25 marks, about 40 minutes).', full: 'About 95 marks of whole structured questions, then a choice of two essays (120 marks, 3 hours).' };
    const shape = () => { $('#shape').textContent = TEXT[sel.part]; };
    document.querySelectorAll('[data-group]').forEach((g) => g.querySelectorAll('.chip').forEach((b) => b.addEventListener('click', () => { g.querySelectorAll('.chip').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true'); sel[g.dataset.group] = b.dataset.v; shape(); })));
    shape();
    const groupsOf = (qs) => { const m = new Map(); for (const q of qs) { if (!m.has(q.g)) m.set(q.g, []); m.get(q.g).push(q); } return [...m.values()]; };
    const marksOf = (g) => g.reduce((a, q) => a + q.m, 0);
    // An essay pair counts once: you answer one of the two.
    const totalOf = (picked) => { const seen = new Set(); return picked.reduce((a, q) => { if (q.ch) { if (seen.has(q.g)) return a; seen.add(q.g); } return a + q.m; }, 0); };
    function fill(groups, target) {
      const out = []; let total = 0;
      for (const g of groups) { const m = marksOf(g); if (total + m <= target + 3) { out.push(g); total += m; } if (total >= target - 3) break; }
      return out;
    }
    const byQ = (a, b) => a.q.localeCompare(b.q, undefined, { numeric: true });
    $('#build').addEventListener('click', () => {
      if (!bank) return;
      const pool = bank.q.filter((q) => q.c && q.p === sel.paper);
      const groups = shuffle(groupsOf(pool.filter((q) => !q.ch)));
      const essays = shuffle(groupsOf(pool.filter((q) => q.ch)));
      let picked = [];
      const add = (g) => { picked = picked.concat(g.slice().sort(byQ)); };
      if (sel.part === 'B') fill(groups, 40).forEach(add);
      else if (sel.part === 'E') add(essays[0]);
      else { fill(groups, 95).forEach(add); add(essays[0]); }
      if (!picked.length) { $('#shape').textContent = 'Nothing matched; try another combination.'; return; }
      show(picked, `${sel.paper}`);
      location.hash = 'set=' + picked.map((q) => q.id).join(',');
      window.scrollTo({ top: 0 });
    });
    function show(picked, label) {
      const total = totalOf(picked);
      $('#setup').hidden = true; $('#paper').hidden = false;
      $('#title').textContent = `${label}: ${picked.length} parts, ${total} marks`;
      secs = Math.round(total * SEC_PER_MARK); $('#timer').textContent = fmtTime(secs); if (timer) clearInterval(timer);
      const holder = $('#cards'); holder.innerHTML = ''; let lastG = null;
      picked.forEach((q, n) => {
        const c = card(q, { mcq: true });
        c.querySelector('.meta strong').textContent = `Part ${n + 1} (from ${q.s} ${q.p} Q${q.q})${q.ch ? ': answer one of the two essays' : ''}`;
        if (q.g === lastG) { const st = c.querySelector('.stemcrop'); if (st) st.remove(); }
        lastG = q.g; holder.appendChild(c);
      });
    }
    $('#share').addEventListener('click', async () => { const url = location.href.split('#')[0] + location.hash; try { await navigator.clipboard.writeText(url); window.maltToast && window.maltToast('Link copied'); } catch { prompt('Copy this link', url); } });
    loadBank().then((b) => { bank = b; const m = location.hash.match(/set=([^&]+)/); if (!m) return; const ids = decodeURIComponent(m[1]).split(','); const picked = ids.map((id) => bank.q.find((q) => q.id === id)).filter(Boolean); if (picked.length) show(picked, 'Shared mock'); });
    $('#starttimer').addEventListener('click', () => { if (timer) clearInterval(timer); timer = setInterval(() => { secs--; $('#timer').textContent = fmtTime(Math.max(secs, 0)); if (secs <= 0) { clearInterval(timer); $('#timer').textContent = "Time's up"; } }, 1000); });
    $('#print').addEventListener('click', () => { document.querySelectorAll('#cards img[data-src]').forEach((img) => { img.src = img.dataset.src; img.removeAttribute('data-src'); }); document.querySelectorAll('#cards details.stem').forEach((d) => { d.open = true; }); setTimeout(() => window.print(), 300); });
    $('#rebuild').addEventListener('click', () => { if (timer) clearInterval(timer); $('#paper').hidden = true; $('#setup').hidden = false; window.scrollTo({ top: 0 }); });
  </script>
</Base>
